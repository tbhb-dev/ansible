{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The preset tracks tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pin (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#ee8796e773fd7b5962f71f2fbd0a16391de33b0f", // main
  ],

  packageRules: [
    {
      // The python-version input of actions/setup-python stays where the
      // workflow sets it. ansible-core 2.21's ansible-test runs only on
      // Python 3.12, 3.13 and 3.14, and the sanity job passes the same
      // version to `ansible-test --python`, which Renovate can't change with
      // it. Move both by hand when the ansible-core range moves.
      description: "Hold setup-python's python-version for ansible-test",
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      matchDepNames: ["python"],
      enabled: false,
    },
  ],
}
